# WARNING: This is a TEMPLATE file with placeholder values
# Copy this file to 01-secrets.yaml and replace all values with actual secrets
# DO NOT commit 01-secrets.yaml to Git!

# To use:
# 1. Copy: cp 01-secrets.yaml.example 01-secrets.yaml
# 2. Replace all placeholder values with actual base64-encoded secrets
# 3. To encode: echo -n "your-value" | base64
# 4. Deploy: kubectl apply -f 01-secrets.yaml

apiVersion: v1
kind: Secret
metadata:
  name: postgres-secret
  namespace: dropmate
type: Opaque
data:
  # Base64 encoded values - REPLACE THESE!
  POSTGRES_USER: <base64-encoded-username>
  POSTGRES_PASSWORD: <base64-encoded-password>
  POSTGRES_DB: <base64-encoded-database-name>
---
apiVersion: v1
kind: Secret
metadata:
  name: app-secret
  namespace: dropmate
type: Opaque
data:
  # Database connection string
  # Format: postgresql://user:password@host:port/database
  DATABASE_URL: <base64-encoded-database-url>

  # JWT Secret for authentication
  JWT_SECRET: <base64-encoded-jwt-secret>

  # Redis connection
  REDIS_URL: <base64-encoded-redis-url>
---
apiVersion: v1
kind: Secret
metadata:
  name: firebase-secret
  namespace: dropmate
type: Opaque
data:
  # Firebase service account JSON - base64 encoded
  service-account.json: <base64-encoded-service-account-json>

  # Firebase config
  FIREBASE_PROJECT_ID: <base64-encoded-project-id>
  FIREBASE_CLIENT_EMAIL: <base64-encoded-client-email>
  FIREBASE_PRIVATE_KEY: <base64-encoded-private-key>
---
apiVersion: v1
kind: Secret
metadata:
  name: sendgrid-secret
  namespace: dropmate
type: Opaque
data:
  # SendGrid API Key
  # Get from: https://app.sendgrid.com/settings/api_keys
  SENDGRID_API_KEY: <base64-encoded-sendgrid-api-key>

  # Sender email (must be verified in SendGrid)
  # Verify at: https://app.sendgrid.com/settings/sender_auth
  SENDGRID_SENDER_EMAIL: <base64-encoded-sender-email>

  # Admin email recipients (comma-separated)
  # For multiple: echo -n "email1@domain.com,email2@domain.com" | base64
  ADMIN_EMAILS: <base64-encoded-admin-emails>
